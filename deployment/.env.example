# Kopyalayıp .env olarak kaydedin (deployment/ dizininde). .env git'e eklenmez.
FG_ENV=development
FG_DB_PASSWORD=dev-only-change-me
# Production: en az 32 karakter rastgele değer, ör. python -c "import secrets;print(secrets.token_urlsafe(48))"
FG_JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
FG_COOKIE_SECURE=false
